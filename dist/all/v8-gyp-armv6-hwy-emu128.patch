--- a/tools/v8_gypfiles/v8.gyp
+++ b/tools/v8_gypfiles/v8.gyp
@@ -2396,7 +2396,17 @@
           ['OS in "aix os400"', {
             'defines': ['HWY_BROKEN_EMU128=0',],
           }],
-          ['v8_target_arch=="arm" and arm_version==7', {
+          # ARMv6 needs this as much as ARMv7 does, and the exact `==7` left it
+          # out. HWY_BROKEN_EMU128 defaults to 1 for GCC older than 14 (a GCC
+          # bug, gcc.gnu.org PR106322), and when it is 1 Highway drops its
+          # fallback target from EMU128 (16 lanes) to SCALAR (1 lane) - while
+          # src/json/json-stringifier.cc asks for hw::FixedTag<uint8_t, 16>
+          # unconditionally. On an ARMv6 target that is a compile error,
+          # "static assertion failed: Too many lanes ... (16 <= 1)", in a host
+          # object built by the same compiler that builds ARMv7 fine WITH the
+          # define. The 6-versus-7 distinction is not about the GCC bug; it is
+          # that upstream builds no ARMv6.
+          ['v8_target_arch=="arm" and (arm_version==7 or arm_version==6)', {
             'defines': ['HWY_BROKEN_EMU128=0',],
           }],
         ],
